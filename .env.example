# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# White-label / branding (optional)
# App name shown in header, title, footer
VITE_APP_NAME=Team Map

# Comma-separated list of allowed email domains for sign-in (e.g. company.com,other.com). If empty, sign-in is restricted.
VITE_ALLOWED_EMAIL_DOMAINS=

# Logo and favicon URLs (paths or full URLs). Defaults: /logo.svg, /favicon.ico
# VITE_LOGO_URL=/logo.svg
# VITE_FAVICON_URL=/favicon.ico

# Set to true to show "Internal tool" label in Hero, Footer, and SignIn page
VITE_SHOW_INTERNAL_TOOL_LABEL=false
